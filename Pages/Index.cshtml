@page
@model SupermarketCatalog.Pages.IndexModel
<!doctype html><html lang="@Model.Lang" dir="@Model.Dir"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#1769ff"><link rel="manifest" href="/manifest.json"><link rel="stylesheet" href="/css/site.css"><title>Market Deals</title></head><body><header class="top"><a class="brand" href="/">🛒 بازار تخفیف</a><nav><a href="#deals">@((Model.Lang=="en")?"Deals":Model.Lang=="ar"?"العروض":"تخفیفەکان")</a><a href="/Admin">پنل مدیریت</a><button id="theme">☾</button><a href="?lang=ku">کوردی</a><a href="?lang=ar">عربي</a><a href="?lang=en">EN</a></nav></header><main><section class="hero"><div><span class="pill">%50 OFF</span><h1>باشترین تخفیفەکان لە یەک شوێن</h1><p>تخفیفە نوێکان بدۆزەرەوە و لە بازاڕە نزیکەکانت کڕین بکە.</p><a class="cta" href="#deals">بینینی تخفیفەکان ←</a></div><div class="hero-art">🛍️<small>تخفیفی ڕۆژ</small></div></section><section id="deals"><div class="section-head"><h2>🔥 تخفیفە چالاکەکان</h2><span>@Model.Deals.Count تخفیف</span></div><div class="grid">@foreach(var d in Model.Deals){<article class="card"><div class="photo"><img src="@d.ImageUrl" alt="@Model.Title(d)"><b>-%@d.Discount</b></div><div class="card-body"><small>🏪 @d.Store?.Name</small><h3>@Model.Title(d)</h3><div class="prices"><strong>@d.Price.ToString("N0") IQD</strong><del>@d.OldPrice.ToString("N0")</del></div><p>تا @d.ExpiresAt.ToLocalTime().ToString("yyyy/MM/dd")</p></div></article>}</div></section></main><footer>© 2026 بازار تخفیف · پلاتفۆرمی تخفیفی سوپرمارکەتەکان</footer><script src="/js/site.js"></script></body></html>