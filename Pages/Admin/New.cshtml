@page
@model SupermarketCatalog.Pages.Admin.NewModel
<!doctype html><html lang="@Model.Lang" dir="@Model.Dir"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="/css/site.css"><title>@(Model.Lang=="en"?"Add Deal":Model.Lang=="ar"?"إضافة عرض":"ئافار زیادکردن")</title></head><body><header class="top"><a class="brand" href="/Admin">🛒 Admin</a><nav><a href="/Admin">@(Model.Lang=="en"?"Dashboard":Model.Lang=="ar"?"لوحة التحكم":"ڕەهەندان")</a><a href="/Auth/Logout">@(Model.Lang=="en"?"Logout":Model.Lang=="ar"?"تسجيل الخروج":"چوونە دەرەوە")</a></nav></header><main class="form-page"><h1>@(Model.Lang=="en"?"Add New Deal":Model.Lang=="ar"?"إضافة عرض جديد":"ئافار نوێ زیادبکە")</h1><form method="post" enctype="multipart/form-data" class="deal-form"><div class="form-group"><label>@(Model.Lang=="en"?"Title (Kurdish)":Model.Lang=="ar"?"العنوان":"سەردێڕ (کوردی)")</label><input asp-for="Deal.Title" placeholder="@(Model.Lang=="en"?"e.g. Fresh Apples":Model.Lang=="ar"?"مثل التفاح الطازج":"بۆ نموونە: سیب تازە")" required class="input-field"></div><div class="form-group"><label>@(Model.Lang=="en"?"Title (Arabic)":Model.Lang=="ar"?"العنوان بالعربية":"سەردێڕ (عەرەبی)")</label><input asp-for="Deal.TitleAr" required class="input-field"></div><div class="form-group"><label>@(Model.Lang=="en"?"Title (English)":Model.Lang=="ar"?"العنوان بالإنجليزية":"سەردێڕ (ئینگلیزی)")</label><input asp-for="Deal.TitleEn" required class="input-field"></div><div class="form-row"><div class="form-group"><label>@(Model.Lang=="en"?"Original Price":Model.Lang=="ar"?"السعر الأصلي":"نرخی ئاصلی")</label><input asp-for="Deal.OldPrice" type="number" required class="input-field"></div><div class="form-group"><label>@(Model.Lang=="en"?"Discount Price":Model.Lang=="ar"?"السعر المخفف":"نرخی تخفیفی")</label><input asp-for="Deal.Price" type="number" required class="input-field"></div><div class="form-group"><label>@(Model.Lang=="en"?"Discount %":Model.Lang=="ar"?"نسبة الخصم":"تێژەی تخفیف")</label><input asp-for="Deal.Discount" type="number" min="1" max="100" required class="input-field"></div></div><div class="form-group"><label>@(Model.Lang=="en"?"Expiry Date":Model.Lang=="ar"?"تاريخ الانتهاء":"بەروار کۆتایی")</label><input asp-for="Deal.ExpiresAt" type="date" required class="input-field"></div><div class="form-group"><label>@(Model.Lang=="en"?"Product Image":Model.Lang=="ar"?"صورة المنتج":"وێنەی محصول")</label><input asp-for="ImageFile" type="file" accept="image/*" class="input-field"></div><div class="form-actions"><button type="submit" class="cta">@(Model.Lang=="en"?"Post Deal":Model.Lang=="ar"?"نشر العرض":"ئافار بنیسە")</button><a href="/Admin" class="cta-secondary">@(Model.Lang=="en"?"Cancel":Model.Lang=="ar"?"إلغاء":"دۆزگە")</a></div></form></main><script src="/js/site.js"></script></body></html>