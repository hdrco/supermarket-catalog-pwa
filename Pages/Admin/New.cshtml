@page
@model SupermarketCatalog.Pages.Admin.NewModel
<!doctype html><html lang="ku" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="/css/site.css"><title>زیادکردنی تخفیف</title></head><body><main class="form-page"><h1>زیادکردنی تخفیفی نوێ</h1><form method="post"><label>ناونیشان<input asp-for="Deal.Title" required></label><label>نرخ<input asp-for="Deal.Price" type="number" required></label><label>نرخی پێشوو<input asp-for="Deal.OldPrice" type="number" required></label><label>ڕێژەی داشکاندن<input asp-for="Deal.Discount" type="number" min="0" max="100" required></label><label>بەستەری وێنە<input asp-for="Deal.ImageUrl" required></label><label>بەرواری کۆتایی<input asp-for="Deal.ExpiresAt" type="date" required></label><button class="cta">پاشەکەوتکردن</button><a href="/Admin">گەڕانەوە</a></form></main></body></html>