@page
@model SupermarketCatalog.Pages.Admin.IndexModel
<!doctype html><html lang="ku" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="/css/site.css"><title>داشبۆرد</title></head><body><header class="top"><a class="brand" href="/">🛒 بازار تخفیف</a><nav><a href="/">سایت</a><a href="/Admin/New">+ تخفیف</a><a href="/Admin/Subscription">اشتراک</a><a href="/Auth/Logout">خروج</a></nav></header><main class="admin"><div class="section-head"><h1>داشبۆرد</h1><span>@Model.Deals.Count تخفیف</span></div><div class="table"><div class="tr head"><span>ناونیشان</span><span>نرخ</span><span>داشکاندن</span><span>کردار</span></div>@foreach(var d in Model.Deals){<div class="tr"><span>@d.Title</span><span>@d.Price.ToString("N0")</span><span class="orange">%@d.Discount</span><span><a href="/Admin/Edit/@d.Id">دەستکاری</a> | <form method="post" asp-page-handler="Delete" asp-route-id="@d.Id" style="display:inline"><button type="submit">سڕینەوە</button></form></span></div>}</div></main></body></html>