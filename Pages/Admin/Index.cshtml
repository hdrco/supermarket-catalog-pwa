@page
@model SupermarketCatalog.Pages.Admin.IndexModel
<!doctype html><html lang="ku" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="/css/site.css"><title>پنلی بەڕێوەبردن</title></head><body><header class="top"><a class="brand" href="/">🛒 بازار تخفیف</a><nav><a href="/">بینینی سایت</a></nav></header><main class="admin"><div class="section-head"><h1>داشبۆردی بەڕێوەبردن</h1><a class="cta" href="/Admin/New">+ زیادکردنی تخفیف</a></div><div class="stats"><div><b>@Model.Deals.Count</b><small>تخفیفی چالاک</small></div><div><b>٣</b><small>زمان</small></div><div><b>PWA</b><small>ئامادەی دامەزراندن</small></div></div><div class="table"><div class="tr head"><span>ناونیشان</span><span>نرخ</span><span>داشکاندن</span><span>بەروار</span></div>@foreach(var d in Model.Deals){<div class="tr"><span>@d.Title</span><span>@d.Price.ToString("N0")</span><span class="orange">%@d.Discount</span><span>@d.ExpiresAt.ToString("yyyy/MM/dd")</span></div>}</div></main><script src="/js/site.js"></script></body></html>