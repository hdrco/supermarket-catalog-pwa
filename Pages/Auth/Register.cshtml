@page
@model SupermarketCatalog.Pages.Auth.RegisterModel
<!doctype html><html lang="@Model.Lang" dir="@Model.Dir"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="/css/site.css"><title>@(Model.Lang=="en"?"Register":Model.Lang=="ar"?"تسجيل":"تۆمار")</title></head><body><main class="auth-page"><div class="auth-box"><h1>@(Model.Lang=="en"?"Register Store":Model.Lang=="ar"?"تسجيل متجر":"بازاڕ تۆمار بکە")</h1><form method="post"><input asp-for="Store.Name" placeholder="@(Model.Lang=="en"?"Store Name":Model.Lang=="ar"?"اسم المتجر":"ناوی بازاڕ")" required><input asp-for="Store.Email" type="email" placeholder="@(Model.Lang=="en"?"Email":Model.Lang=="ar"?"البريد":"ئیمەیل")" required><input asp-for="Password" type="password" placeholder="@(Model.Lang=="en"?"Password":Model.Lang=="ar"?"كلمة السر":"تێپەڕ")" required><button class="cta">@(Model.Lang=="en"?"Register":Model.Lang=="ar"?"تسجيل":"تۆمار بکە")</button></form><p><a href="/Auth/Login">@(Model.Lang=="en"?"Already have account?":Model.Lang=="ar"?"لديك حساب بالفعل؟":"ھێشتا ھەسابت ھەیە؟")</a></p></div></main></body></html>