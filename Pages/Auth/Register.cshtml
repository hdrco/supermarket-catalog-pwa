@page
@model SupermarketCatalog.Pages.Auth.RegisterModel
<!doctype html><html lang="@Model.Lang" dir="@Model.Dir"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="/css/site.css"><link rel="stylesheet" href="/css/auth.css"><title>@(Model.Lang=="en"?"Register":Model.Lang=="ar"?"تسجيل":"تۆمار")</title></head><body><main class="auth-page"><div class="auth-box"><h1>@(Model.Lang=="en"?"Register Store":Model.Lang=="ar"?"تسجيل متجر":"بازار تۆمار بکە")</h1><form method="post"><div class="form-group"><label>@(Model.Lang=="en"?"Store Name":Model.Lang=="ar"?"اسم المتجر":"ناوی بازار")</label><input asp-for="StoreName" placeholder="@(Model.Lang=="en"?"Enter store name":Model.Lang=="ar"?"أدخل اسم المتجر":"ناوی بازار تێبکە")" required class="input-field"></div><div class="form-group"><label>@(Model.Lang=="en"?"Email":Model.Lang=="ar"?"البريد":"ئیمەیل")</label><input asp-for="Email" type="email" placeholder="store@example.com" required class="input-field"></div><div class="form-group"><label>@(Model.Lang=="en"?"Password":Model.Lang=="ar"?"كلمة السر":"تێپەڕ")</label><input asp-for="Password" type="password" required class="input-field"></div><div class="form-group"><label>@(Model.Lang=="en"?"Confirm Password":Model.Lang=="ar"?"تأكيد كلمة السر":"تێپەڕ پشتڕاستی کە")</label><input asp-for="ConfirmPassword" type="password" required class="input-field"></div><button type="submit" class="cta">@(Model.Lang=="en"?"Register":Model.Lang=="ar"?"تسجيل":"تۆمار بکە")</button></form><p><a href="/Auth/Login">@(Model.Lang=="en"?"Already have account?":Model.Lang=="ar"?"لديك حساب بالفعل؟":"هێشتا هەساب هەیە؟")</a></p></div></main><script src="/js/site.js"></script></body></html>