@page
@model SupermarketCatalog.Pages.Auth.LoginModel
<!doctype html><html lang="@Model.Lang" dir="@Model.Dir"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="/css/site.css"><link rel="stylesheet" href="/css/auth.css"><title>@(Model.Lang=="en"?"Login":Model.Lang=="ar"?"دخول":"چوون ناو")</title></head><body><main class="auth-page"><div class="auth-box"><h1>@(Model.Lang=="en"?"Store Login":Model.Lang=="ar"?"دخول المتجر":"بازار چوون ناو")</h1><form method="post"><div class="form-group"><label>@(Model.Lang=="en"?"Email":Model.Lang=="ar"?"البريد":"ئیمەیل")</label><input asp-for="Email" type="email" placeholder="store@example.com" required class="input-field"></div><div class="form-group"><label>@(Model.Lang=="en"?"Password":Model.Lang=="ar"?"كلمة السر":"تێپەڕ")</label><input asp-for="Password" type="password" required class="input-field"></div><div class="form-group"><label><input asp-for="RememberMe" type="checkbox"> @(Model.Lang=="en"?"Remember me":Model.Lang=="ar"?"تذكرني":"بیرم تێبکە")</label></div><button type="submit" class="cta">@(Model.Lang=="en"?"Login":Model.Lang=="ar"?"دخول":"چوون ناو")</button></form><p><a href="/Auth/Register">@(Model.Lang=="en"?"Create new account":Model.Lang=="ar"?"إنشاء حساب جديد":"هەساب نوێ دروستبکە")</a></p></div></main><script src="/js/site.js"></script></body></html>