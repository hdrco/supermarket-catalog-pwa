@page
@model SupermarketCatalog.Pages.Auth.LoginModel
<!doctype html><html lang="@Model.Lang" dir="@Model.Dir"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="/css/site.css"><title>@(Model.Lang=="en"?"Login":Model.Lang=="ar"?"دخول":"چوون ناو")</title></head><body><main class="auth-page"><div class="auth-box"><h1>@(Model.Lang=="en"?"Store Login":Model.Lang=="ar"?"دخول المتجر":"بازاڕ چوون ناو")</h1><form method="post"><input type="email" placeholder="@(Model.Lang=="en"?"Email":Model.Lang=="ar"?"البريد":"ئیمەیل")" required><input type="password" placeholder="@(Model.Lang=="en"?"Password":Model.Lang=="ar"?"كلمة السر":"تێپەڕ")" required><button class="cta">@(Model.Lang=="en"?"Login":Model.Lang=="ar"?"دخول":"چوون ناو")</button></form><p><a href="/Auth/Register">@(Model.Lang=="en"?"Create account":Model.Lang=="ar"?"إنشاء حساب":"ھەسابی نوی دروستبکە")</a></p></div></main></body></html>