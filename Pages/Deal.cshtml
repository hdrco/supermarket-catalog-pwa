@page "{id:int}"
@model SupermarketCatalog.Pages.DealModel
@{
    var lang = Model.Lang;
    var dir = Model.Dir;
}
<!doctype html>
<html lang="@lang" dir="@dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Title()</title>
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body class="detail-body">
    <header class="topbar detail-topbar">
        <div class="container topbar-inner">
            <div class="brand-wrap">
                <div class="brand-mark">ع</div>
                <div>
                    <div class="brand-name">Erbil Deals</div>
                    <small>Offer details</small>
                </div>
            </div>
            <a class="back-link" href="/">← Back</a>
        </div>
    </header>

    <main class="detail-shell container">
        @if (Model.Deal is null)
        {
            <div class="not-found-box">
                <h2>Offer not found</h2>
                <p>This deal may have expired or is no longer available.</p>
                <a href="/" class="primary-btn">Back to homepage</a>
            </div>
        }
        else
        {
            <article class="detail-card">
                <div class="detail-image-wrap">
                    <img src="@Model.Deal.ImageUrl" alt="@Model.Title()" />
                    <span class="deal-discount large">-@Model.Deal.Discount%</span>
                </div>

                <div class="detail-content">
                    <div class="detail-meta-row">
                        <span class="store-pill">@Model.Deal.Store?.Name</span>
                        <span class="status-pill">Limited offer</span>
                    </div>

                    <h1>@Model.Title()</h1>
                    <div class="detail-price-row">
                        <strong>@Model.Deal.Price.ToString("N0") IQD</strong>
                        <del>@Model.Deal.OldPrice.ToString("N0") IQD</del>
                    </div>

                    <div class="detail-info-grid">
                        <div>
                            <span class="label">Savings</span>
                            <strong>@(Model.Deal.OldPrice - Model.Deal.Price) IQD</strong>
                        </div>
                        <div>
                            <span class="label">Ends</span>
                            <strong>@Model.Deal.ExpiresAt.ToString("dd MMM yyyy")</strong>
                        </div>
                        <div>
                            <span class="label">City</span>
                            <strong>Erbil</strong>
                        </div>
                    </div>

                    <p class="detail-copy">
                        This special offer is available for a limited time only. Visit the store or contact the market directly to claim the promotion.
                    </p>

                    <div class="detail-actions">
                        <a class="primary-btn" href="/">View all deals</a>
                        <a class="secondary-btn" href="/Stores">Go to stores</a>
                    </div>
                </div>
            </article>
        }
    </main>

    <script src="/js/site.js"></script>
</body>
</html>
