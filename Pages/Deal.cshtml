@page "{id}"
@model SupermarketCatalog.Pages.DealModel
<!doctype html><html lang="@Model.Lang" dir="@Model.Dir"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="/css/site.css"><title>@Model.Deal?.Title</title></head><body><header class="top"><a class="brand" href="/">🛒</a><nav><a href="/">@(Model.Lang=="en"?"Home":Model.Lang=="ar"?"الرئيسية":"سەرەتا")</a><a href="/Deals">@(Model.Lang=="en"?"Deals":Model.Lang=="ar"?"العروض":"تخفیفەکان")</a><button id="theme">🌙</button></nav></header><main class="deal-detail">@if(Model.Deal!=null){<div class="detail-container"><img src="@Model.Deal.ImageUrl" alt="@Model.Title()" class="main-image"><div class="detail-info"><h1>@Model.Title()</h1><small>@Model.Deal.Store?.Name</small><div class="prices"><strong class="price">@Model.Deal.Price.ToString("N0") IQD</strong><del>@Model.Deal.OldPrice.ToString("N0") IQD</del><span class="discount">%@Model.Deal.Discount</span></div><p>@(Model.Lang=="en"?"Expires":Model.Lang=="ar"?"ينتهي":"تێدەچێت"): @Model.Deal.ExpiresAt.ToString("yyyy/MM/dd")</p><a href="/Deals" class="cta">@(Model.Lang=="en"?"Back to Deals":Model.Lang=="ar"?"العودة للعروض":"گەڕانە تخفیفەکان")</a></div></div>}else{<p>Not found</p></main><footer>© 2026</footer><script src="/js/site.js"></script></body></html>