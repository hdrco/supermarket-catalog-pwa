@page "{id}"
@model SupermarketCatalog.Pages.StoreModel
<!doctype html><html lang="@Model.Lang" dir="@Model.Dir"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="/css/site.css"><title>@Model.Store?.Name</title></head><body><header class="top"><a class="brand" href="/">🛒</a><nav><a href="/">@(Model.Lang=="en"?"Home":Model.Lang=="ar"?"الرئيسية":"سەرەتا")</a><a href="/Stores">@(Model.Lang=="en"?"Stores":Model.Lang=="ar"?"المتاجر":"بازاڕ")</a><button id="theme">🌙</button></nav></header><main>@if(Model.Store!=null){<div class="store-header"><h1>@Model.Store.Name</h1><p>@Model.Store.Email</p></div><div class="grid">@foreach(var d in Model.Deals){<article class="card"><div class="photo"><img src="@d.ImageUrl" alt="@d.Title"><b>-@d.Discount%</b></div><div class="card-body"><h3>@d.Title</h3><div class="prices"><strong>@d.Price.ToString("N0")</strong><del>@d.OldPrice.ToString("N0")</del></div><a href="/Deal/@d.Id" class="cta">@(Model.Lang=="en"?"View":Model.Lang=="ar"?"عرض":"بینین")</a></div></article>}</div>}</main><footer>© 2026</footer><script src="/js/site.js"></script></body></html>