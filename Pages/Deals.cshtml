@page
@model SupermarketCatalog.Pages.IndexModel
@{
    var lang = Model.Lang;
    var dir = Model.Dir;
}
<!doctype html>
<html lang="@lang" dir="@dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0f766e" />
    <title>MarketHub Iraq</title>
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body class="home-page">
    <header class="topbar premium-topbar">
        <div class="container topbar-inner">
            <div class="brand-wrap">
                <div class="brand-mark">M</div>
                <div>
                    <div class="brand-name">MarketHub</div>
                    <small>Erbil • Baghdad • Sulaymaniyah</small>
                </div>
            </div>

            <nav class="main-nav" aria-label="Main navigation">
                <a class="active" href="/">Home</a>
                <a href="/Deals">Deals</a>
                <a href="/Stores">Stores</a>
                <a href="/About">About</a>
            </nav>

            <div class="header-tools">
                <a class="ghost-btn" href="/Deals">View all</a>
                <div class="language-switch">
                    <a href="/?lang=ku">KUR</a>
                    <a href="/?lang=ar">AR</a>
                    <a href="/?lang=en">EN</a>
                </div>
            </div>
        </div>
    </header>

    <main>
        <section class="container hero-section">
            <div class="hero-copy">
                <div class="eyebrow">Smart shopping in Iraq</div>
                <h1>Hot offers and daily discounts for your family.</h1>
                <p>Find the best prices on groceries, electronics, home essentials, and fresh products from trusted stores across Iraq.</p>

                <form class="search-box" method="get" action="/Deals">
                    <input type="text" name="q" placeholder="Search deals, categories, stores..." aria-label="Search deals" />
                    <button type="submit">Search</button>
                </form>

                <div class="hero-actions">
                    <a class="primary-btn" href="/Deals">Explore offers</a>
                    <a class="secondary-btn" href="/Stores">Browse stores</a>
                </div>

                <div class="mini-stats">
                    <div>
                        <strong>420+</strong>
                        <span>active offers</span>
                    </div>
                    <div>
                        <strong>36</strong>
                        <span>stores</span>
                    </div>
                    <div>
                        <strong>4.8/5</strong>
                        <span>customer rating</span>
                    </div>
                </div>
            </div>

            <div class="hero-visual">
                <div class="spotlight-card large">
                    <div class="tiny-tag">This week</div>
                    <h3>Up to 60% off</h3>
                    <p>Fresh groceries and essential household items selected for your city.</p>
                </div>
                <div class="spotlight-card small">
                    <div class="tiny-tag">Fast delivery</div>
                    <h4>Free shipping above 50K IQD</h4>
                </div>
            </div>
        </section>

        <section class="container category-section">
            <div class="section-heading">
                <h2>Popular categories</h2>
                <a href="/Deals">See all</a>
            </div>

            <div class="category-grid">
                <a class="category-card" href="/Deals?category=Groceries">
                    <span>🥬</span>
                    <strong>Groceries</strong>
                </a>
                <a class="category-card" href="/Deals?category=Home">
                    <span>🧴</span>
                    <strong>Home</strong>
                </a>
                <a class="category-card" href="/Deals?category=Electronics">
                    <span>📱</span>
                    <strong>Electronics</strong>
                </a>
                <a class="category-card" href="/Deals?category=Fashion">
                    <span>👕</span>
                    <strong>Fashion</strong>
                </a>
                <a class="category-card" href="/Deals?category=Bakery">
                    <span>🥐</span>
                    <strong>Bakery</strong>
                </a>
                <a class="category-card" href="/Deals?category=Drinks">
                    <span>🥤</span>
                    <strong>Drinks</strong>
                </a>
            </div>
        </section>

        <section class="container deals-section">
            <div class="section-heading">
                <h2>Featured deals</h2>
                <a href="/Deals">View all offers</a>
            </div>

            <div class="deal-grid">
                @if (!Model.Deals.Any())
                {
                    <div class="empty-state">No active deals available at the moment.</div>
                }
                else
                {
                    @foreach (var deal in Model.Deals)
                    {
                        <article class="deal-card">
                            <a href="/Deal/@deal.Id?lang=@lang" class="deal-image-wrap">
                                <img src="@deal.ImageUrl" alt="@Model.GetDealTitle(deal)" />
                                <span class="deal-badge">-@deal.Discount%</span>
                            </a>

                            <div class="deal-body">
                                <div class="deal-card-top">
                                    <span class="store-tag">@Model.GetStoreName(deal.Store)</span>
                                    <span class="live-tag">Live</span>
                                </div>

                                <h3>@Model.GetDealTitle(deal)</h3>

                                <div class="price-row">
                                    <strong>@deal.Price.ToString("N0") IQD</strong>
                                    <del>@deal.OldPrice.ToString("N0") IQD</del>
                                </div>

                                <div class="deal-footer">
                                    <span>Ends @deal.ExpiresAt.ToString("dd MMM yyyy")</span>
                                    <a href="/Deal/@deal.Id?lang=@lang" class="small-btn">Open</a>
                                </div>
                            </div>
                        </article>
                    }
                }
            </div>
        </section>

        <section class="container stores-section">
            <div class="section-heading">
                <h2>Top stores</h2>
                <a href="/Stores">Explore stores</a>
            </div>

            <div class="store-grid">
                @foreach (var store in Model.Stores)
                {
                    <a href="/Store/@store.Id?lang=@lang" class="store-card">
                        <div class="store-badge">@store.Rating?.ToString("0.0")/5</div>
                        <div class="store-logo">@((store.Name.Length > 0 ? store.Name[0].ToString().ToUpperInvariant() : "S"))</div>
                        <h3>@store.GetName(lang)</h3>
                        <p>@store.GetDescription(lang)</p>
                        <div class="store-meta">
                            <span>@(store.Deals.Count) deals</span>
                            <span>Verified</span>
                        </div>
                    </a>
                }
            </div>
        </section>

        <section class="container feature-strip">
            <div class="feature-item">
                <div class="feature-icon">⚡</div>
                <div>
                    <strong>Fast updates</strong>
                    <span>Fresh offers every day</span>
                </div>
            </div>
            <div class="feature-item">
                <div class="feature-icon">🛡️</div>
                <div>
                    <strong>Trusted stores</strong>
                    <span>Verified sellers only</span>
                </div>
            </div>
            <div class="feature-item">
                <div class="feature-icon">📍</div>
                <div>
                    <strong>Local focus</strong>
                    <span>Built for Iraqi markets</span>
                </div>
            </div>
        </section>
    </main>

    <footer class="site-footer">
        <div class="container footer-inner">
            <div>
                <div class="brand-name">MarketHub</div>
                <p>Better deals for better shopping.</p>
            </div>
            <div class="footer-links">
                <a href="/Deals">Deals</a>
                <a href="/Stores">Stores</a>
                <a href="/About">About</a>
            </div>
        </div>
    </footer>
</body>
</html>
