@page
@model SupermarketCatalog.Pages.DealsModel
<!doctype html><html lang="@Model.Lang" dir="@Model.Dir"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="/css/site.css"><title>@(Model.Lang=="en"?"All Deals":Model.Lang=="ar"?"جميع العروض":"هەموو تخفیفەکان")</title></head><body><header class="top"><a class="brand" href="/">🛒</a><nav><a href="/">@(Model.Lang=="en"?"Home":Model.Lang=="ar"?"الرئيسية":"سەرەتا")</a><a href="/Deals">@(Model.Lang=="en"?"Deals":Model.Lang=="ar"?"العروض":"تخفیفەکان")</a><a href="/Stores">@(Model.Lang=="en"?"Stores":Model.Lang=="ar"?"المتاجر":"بازاڕ")</a><button id="theme">🌙</button><a href="?lang=ku">Kurdish</a><a href="?lang=ar">عربي</a><a href="?lang=en">EN</a></nav></header><main><div class="section-head"><h1>@(Model.Lang=="en"?"All Deals":Model.Lang=="ar"?"جميع العروض":"هەموو تخفیفەکان")</h1></div><div class="filters"><button class="filter-btn active" data-filter="all">@(Model.Lang=="en"?"All":Model.Lang=="ar"?"الكل":"هەموو")</button><button class="filter-btn" data-filter="50">%50+</button><button class="filter-btn" data-filter="30">%30+</button><button class="filter-btn" data-filter="10">%10+</button></div><div class="grid">@foreach(var d in Model.Deals){<article class="card"><div class="photo"><img src="@d.ImageUrl" alt="@Model.Title(d)"><b>-@d.Discount%</b></div><div class="card-body"><small>@d.Store?.Name</small><h3>@Model.Title(d)</h3><div class="prices"><strong>@d.Price.ToString("N0") IQD</strong><del>@d.OldPrice.ToString("N0")</del></div><p>@d.ExpiresAt.ToString("yyyy/MM/dd")</p><a href="/Deal/@d.Id" class="cta">@(Model.Lang=="en"?"View":Model.Lang=="ar"?"عرض":"بینین")</a></div></article>}</div></main><footer>© 2026 @(Model.Lang=="en"?"Market Deals":Model.Lang=="ar"?"عروض السوق":"بازاری تخفیفی")</footer><script src="/js/site.js"></script></body></html>