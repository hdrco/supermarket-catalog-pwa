using Microsoft.AspNetCore.Mvc.RazorPages;
using Microsoft.EntityFrameworkCore;
using SupermarketCatalog.Data;
using SupermarketCatalog.Models;

namespace SupermarketCatalog.Pages;

public class DealsModel(AppDbContext db) : PageModel
{
    public List<Deal> Deals { get; set; } = [];
    public string Lang => Request.Query["lang"].FirstOrDefault() ?? Request.Cookies["lang"] ?? "ku";
    public string Dir => Lang == "en" ? "ltr" : "rtl";
    public string SearchTerm => Request.Query["q"].FirstOrDefault() ?? string.Empty;
    public string Category => Request.Query["category"].FirstOrDefault() ?? string.Empty;

    public async Task OnGetAsync()
    {
        var query = db.Deals
            .Include(x => x.Store)
            .Where(x => x.ExpiresAt > DateTime.UtcNow && x.IsActive)
            .AsQueryable();

        if (!string.IsNullOrWhiteSpace(SearchTerm))
        {
            var term = SearchTerm.Trim();
            query = query.Where(x =>
                x.Title.Contains(term) ||
                x.TitleAr.Contains(term) ||
                x.TitleEn.Contains(term) ||
                (x.Store != null && (x.Store.Name.Contains(term) || x.Store.NameAr.Contains(term) || x.Store.NameEn.Contains(term))));
        }

        if (!string.IsNullOrWhiteSpace(Category))
        {
            query = query.Where(x => x.Category == Category || x.CategoryAr == Category);
        }

        Deals = await query
            .OrderByDescending(x => x.Discount)
            .ToListAsync();
    }

    public string Title(Deal d) => d.GetTitle(Lang);
}
