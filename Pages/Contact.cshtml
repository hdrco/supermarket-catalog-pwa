@page
@model SupermarketCatalog.Pages.ContactModel
<!doctype html><html lang="@Model.Lang" dir="@Model.Dir"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="/css/site.css"><title>@(Model.Lang=="en"?"Contact":Model.Lang=="ar"?"اتصل":"پەیوەندی")</title></head><body><header class="top"><a class="brand" href="/">🛒</a><nav><a href="/">@(Model.Lang=="en"?"Home":Model.Lang=="ar"?"الرئيسية":"سەرەتا")</a><a href="/Contact">@(Model.Lang=="en"?"Contact":Model.Lang=="ar"?"اتصل":"پەیوەندی")</a><button id="theme">🌙</button></nav></header><main class="content-page"><h1>@(Model.Lang=="en"?"Contact Us":Model.Lang=="ar"?"اتصل بنا":"پەیوەندی بێ ئێمە")</h1><form method="post"><input type="text" placeholder="@(Model.Lang=="en"?"Name":Model.Lang=="ar"?"الاسم":"ناو")" required><input type="email" placeholder="@(Model.Lang=="en"?"Email":Model.Lang=="ar"?"البريد الإلكتروني":"ئیمەیل")" required><textarea placeholder="@(Model.Lang=="en"?"Message":Model.Lang=="ar"?"الرسالة":"پەیام")" rows="5" required></textarea><button class="cta">@(Model.Lang=="en"?"Send":Model.Lang=="ar"?"إرسال":"بنێرە")</button></form></main><footer>© 2026</footer><script src="/js/site.js"></script></body></html>